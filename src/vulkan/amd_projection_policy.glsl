// Measured gfx1151 projection traversal for FP16/BF16 at N=1..8192.
// The stagger distance is 128 elements; policy selection does not change it.
// Scalar output projections use their separate sequential accumulation path.
bool layaAmdProjectionStagger(uint k, uint m, uint n, bool bf16) {
    if (bf16) return
        (k==256u && m==2u && n>=768u && n<=1535u) ||
        (k==256u && m==2u && n>=3072u && n<=8192u) ||
        (k==768u && m==1u && n>=1u && n<=8192u) ||
        (k==768u && m==768u && n>=3072u && n<=8192u) ||
        (k==768u && m==2304u && n>=1536u && n<=8192u) ||
        (k==768u && m==3072u && n>=1536u && n<=8192u) ||
        (k==772u && m==256u && n>=1u && n<=95u) ||
        (k==772u && m==256u && n>=384u && n<=1535u) ||
        (k==1024u && m==1u && n>=1u && n<=8192u) ||
        (k==1024u && m==1024u && n>=3072u && n<=8192u) ||
        (k==1024u && m==3072u && n>=1536u && n<=8192u) ||
        (k==1024u && m==4096u && n>=1u && n<=95u) ||
        (k==1024u && m==4096u && n>=768u && n<=8192u) ||
        (k==1024u && m==5248u && n>=1u && n<=95u) ||
        (k==1024u && m==5248u && n>=768u && n<=8192u) ||
        (k==1028u && m==256u && n>=1u && n<=95u) ||
        (k==1028u && m==256u && n>=384u && n<=1535u) ||
        (k==1152u && m==768u && n>=3072u && n<=8192u) ||
        (k==2624u && m==1024u && n>=384u && n<=767u) ||
        (k==2624u && m==1024u && n>=768u && n<=1535u) ||
        (k==2624u && m==1024u && n>=3072u && n<=8192u) ||
        (k==3072u && m==768u && n>=192u && n<=383u) ||
        (k==3072u && m==768u && n>=384u && n<=767u) ||
        (k==3072u && m==768u && n>=3073u && n<=8192u) ||
        (k==4096u && m==1024u && n>=192u && n<=383u) ||
        (k==4096u && m==1024u && n>=384u && n<=767u) ||
        (k==4096u && m==1024u && n>=3073u && n<=8192u);
    return
        (k==256u && m==2u && n>=1u && n<=95u) ||
        (k==768u && m==1u && n>=1u && n<=8192u) ||
        (k==768u && m==2304u && n>=1u && n<=95u) ||
        (k==768u && m==2304u && n>=1536u && n<=8192u) ||
        (k==768u && m==3072u && n>=1u && n<=95u) ||
        (k==768u && m==3072u && n>=1536u && n<=8192u) ||
        (k==772u && m==256u && n>=192u && n<=767u) ||
        (k==1024u && m==1u && n>=1u && n<=8192u) ||
        (k==1024u && m==3072u && n>=1u && n<=95u) ||
        (k==1024u && m==3072u && n>=1536u && n<=8192u) ||
        (k==1024u && m==4096u && n>=1u && n<=95u) ||
        (k==1024u && m==4096u && n>=1536u && n<=8192u) ||
        (k==1024u && m==5248u && n>=1u && n<=95u) ||
        (k==1024u && m==5248u && n>=1536u && n<=8192u) ||
        (k==1028u && m==256u && n>=192u && n<=767u) ||
        (k==2624u && m==1024u && n>=384u && n<=767u) ||
        (k==2624u && m==1024u && n>=1536u && n<=8192u) ||
        (k==3072u && m==768u && n>=384u && n<=8192u) ||
        (k==4096u && m==1024u && n>=384u && n<=8192u);
}
